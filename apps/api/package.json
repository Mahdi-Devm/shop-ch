{
  "name": "api",
  "version": "0.0.1",
  "description": "Flash sale Order and Inventory services",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch --entryFile order/main",
    "dev:inventory": "nest start --watch --entryFile inventory/main --preserveWatchOutput",
    "start:order": "node dist/order/main",
    "start:inventory": "node dist/inventory/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "seed": "TS_NODE_PROJECT=tsconfig.commonjs.json ts-node -r tsconfig-paths/register src/inventory/seed/seed.ts",
    "migration:generate:order": "TS_NODE_PROJECT=tsconfig.commonjs.json ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -p -d src/order/config/order.data-source.ts",
    "migration:generate:inventory": "TS_NODE_PROJECT=tsconfig.commonjs.json ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -p -d src/inventory/config/inventory.data-source.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.2",
    "@repo/eslint-config": "workspace:*",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/rabbitmq": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@order/(.*)$": "<rootDir>/order/$1",
      "^@inventory/(.*)$": "<rootDir>/inventory/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "reflect-metadata"
    ]
  }
}
